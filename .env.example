# ---------------------------------------------------------------------------
# movierec configuration. Copy to `.env` and fill in. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# REQUIRED. Free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# REQUIRED for review structuring, dossiers and the natural-language layer.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Model selection -------------------------------------------------------
MOVIEREC_LLM_MODEL=claude-sonnet-5
MOVIEREC_LLM_MAX_CONCURRENCY=4

# --- Embeddings ------------------------------------------------------------
# Backend: sentence_transformers | hash (deterministic, offline, tests only)
MOVIEREC_EMBED_BACKEND=sentence_transformers
MOVIEREC_EMBED_MODEL=BAAI/bge-small-en-v1.5
MOVIEREC_EMBED_BATCH=64

# --- Catalog scope ---------------------------------------------------------
# Target number of films in the candidate universe.
MOVIEREC_CATALOG_SIZE=30000
# Minimum TMDB vote count for a film to enter the catalog on its own merit.
MOVIEREC_MIN_VOTES=50
# Earliest release year to consider.
MOVIEREC_MIN_YEAR=1930

# How many films get a Wikipedia plot synopsis up front. Your own films and
# watchlist always come first; the rest are fetched on demand as needed.
MOVIEREC_WIKIPEDIA_LIMIT=8000
# How many of your own films Claude profiles during setup (drives taste scales).
MOVIEREC_DOSSIER_SEED_LIMIT=400

# --- Optional sources ------------------------------------------------------
MOVIEREC_ENABLE_MOVIELENS=true
MOVIEREC_ENABLE_IMDB=true
MOVIEREC_ENABLE_WIKIPEDIA=true

# --- Paths (override only if you move things) ------------------------------
# MOVIEREC_DB_PATH=db/movierec.db
# MOVIEREC_DATA_DIR=data
